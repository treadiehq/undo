{
  "name": "undo-launch-video",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Conversion-focused launch video for Undo",
  "scripts": {
    "audio": "python3 scripts/generate-audio.py",
    "predev": "npm run audio",
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "prerender": "npm run audio",
    "render": "remotion render UndoLaunch out/undo-launch.mp4",
    "prerender:poster": "npm run audio",
    "render:poster": "remotion still UndoLaunch out/undo-launch-poster.png --frame=1185"
  },
  "dependencies": {
    "@remotion/cli": "4.0.489",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
